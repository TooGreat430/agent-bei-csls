# ===== Project =====
LIB_PROJECT_ID=my-gcp-project
LIB_SEARCH_LOCATION=global          # lokasi data store GE: global | us | eu (samakan dengan app GE)
LIB_GEMINI_LOCATION=global          # lokasi Vertex AI untuk model Gemini
LIB_AGENT_ENGINE_REGION=asia-southeast2 # region deploy Agent Engine (Jakarta)
LIB_AGENT_DISPLAY_NAME=marketing-insight-assistant  # nama internal di Agent Runtime (tidak terlihat user)

# ===== Data store perpustakaan =====
LIB_DATASTORE_ID=perpustakaan-dokumen
LIB_SERVING_CONFIG=default_config
LIB_SEARCH_RESULT_MODE=CHUNKS       # CHUNKS (sitasi per halaman) | DOCUMENTS

# ===== Cloud Storage =====
LIB_BUCKET=my-library-bucket
# Folder kerja agent (katalog, insight, pengaturan, template, laporan). Bukan tempat dokumen.
LIB_INTERNAL_FOLDER=ge-docs-agent
LIB_TEMPLATE_SOURCE=gcs             # gcs (produksi) | local (pengembangan)

# Bucket laporan terpisah (disarankan). Kosongkan untuk memakai LIB_BUCKET.
LIB_REPORT_BUCKET=my-library-reports

# ===== Data aplikasi di GCS (katalog & insight) =====

# ===== Model (isi dengan versi Gemini terbaru yang tersedia di project) =====
LIB_MODEL_FAST=gemini-3.5-flash
LIB_MODEL_PRO=gemini-3.5-flash

# ===== Aturan perpustakaan =====
LIB_DOC_TYPES=BEI,CSLS
# Penjelasan jenis dokumen agar Gemini bisa mengklasifikasi otomatis saat upload
LIB_DOC_TYPE_HINTS="BEI: <jelaskan isi dokumen BEI>; CSLS: <jelaskan isi dokumen CSLS>"
LIB_MAX_ACTIVE_DOCS=10
# Folder dokumen: SATU-SATUNYA tempat file dokumen perpustakaan
LIB_SOURCE_FOLDER=gs://ptpl-ge-bucket/ge-docs-datastore/
LIB_FOLDER_BATCH_SIZE=20
LIB_MAX_FILE_MB=100
LIB_AGENT_NAME=Marketing Insight Assistant
LIB_COMPANY_NAME=Nama Perusahaan Klien

# Untuk `adk web` lokal
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=my-gcp-project
GOOGLE_CLOUD_LOCATION=global

# ===== Data Agent BigQuery (Marketing Intelligence) =====
LIB_DATA_AGENT=projects/ptpl-land-dev/locations/global/dataAgents/agent_4df3074b-9d7e-4f9f-993b-b3969b8a2095
LIB_DATA_AGENT_BILLING_PROJECT=ptpl-land-dev
LIB_DATA_AGENT_LOCATION=global
LIB_DATA_AUTH_MODE=service_account
LIB_DATA_AUTH_ID=mia-bigquery
