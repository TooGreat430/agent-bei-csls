# ===== Project =====
LIB_PROJECT_ID=ptpl-land-dev
LIB_AGENT_ENGINE_REGION=asia-southeast2  # region Agent Engine (Jakarta)
LIB_AGENT_DISPLAY_NAME=marketing-insight-assistant  # nama internal di Agent Runtime (tidak terlihat user)
# Diisi otomatis oleh scripts/update_agent.sh saat pertama kali menemukan resource agent:
# LIB_AGENT_RESOURCE=projects/<nomor-project>/locations/asia-southeast2/reasoningEngines/<ID>

# ===== Model =====
# Model cepat: router & tanya-jawab data BigQuery
LIB_MODEL_FAST=gemini-3.5-flash
LIB_GEMINI_LOCATION=global
# Model utama: analisis file CSV/Excel, laporan custom, narasi laporan template
LIB_MODEL_PRO=gemini-4-argon
LIB_GEMINI_LOCATION_PRO=asia-southeast1

# ===== Cloud Storage =====
LIB_BUCKET=ptpl-ge-bucket
# Folder kerja agent: file data unggahan per chat, settings.json, salinan pengetahuan Data Agent, laporan
LIB_INTERNAL_FOLDER=ge-docs-agent
# Bucket laporan (kosongkan untuk memakai LIB_BUCKET)
LIB_REPORT_BUCKET=
LIB_MAX_FILE_MB=100
LIB_AGENT_NAME=Marketing Insight Assistant
LIB_COMPANY_NAME=PT Pertamina Lubricants

# ===== Data Agent BigQuery (Conversational Analytics) =====
LIB_DATA_AGENT=projects/ptpl-land-dev/locations/global/dataAgents/agent_4df3074b-9d7e-4f9f-993b-b3969b8a2095
LIB_DATA_AGENT_INDUSTRY=projects/ptpl-land-dev/locations/global/dataAgents/agent_04f517f4-e06b-44e8-b0af-d55792ef5222
LIB_DATA_AGENT_PLANOGRAM=projects/ptpl-land-dev/locations/global/dataAgents/agent_5f69a707-a240-49ea-9c96-dd12493f659c
LIB_DATA_AGENT_SELLOUT=projects/ptpl-land-dev/locations/global/dataAgents/agent_e188b55c-e61b-4c3f-9f91-3c97a54a6d4a
LIB_DATA_AGENT_BILLING_PROJECT=ptpl-land-dev
LIB_DATA_AGENT_LOCATION=global
LIB_DATA_AUTH_MODE=service_account
LIB_DATA_AUTH_ID=mia-bigquery

# ===== Tabel laporan template (query BigQuery langsung, angka dihitung kode) =====
LIB_PRICE_TABLE=ptpl-curated-prd.DATAMART.SURVEY_PRODUCTS
LIB_INDUSTRY_TABLE=ptpl-curated-prd.DATAMART.survey_industry
LIB_PLANOGRAM_TABLE=ptpl-curated-prd.DATAMART.VM_PLANOGRAM
LIB_PLANOGRAM_DEFAULT_PERIOD=2026-Q3

# Untuk `adk web` lokal
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=ptpl-land-dev
GOOGLE_CLOUD_LOCATION=global

# ===== Analisis berbasis kode (Agent Engine Code Execution) — dinyalakan lewat settings.json =====
# Induk sandbox = LIB_AGENT_RESOURCE (agent ini). Mesin sandbox tetap 4 vCPU / 4 GiB.
LIB_CODE_EXECUTION_MACHINE=MACHINE_CONFIG_VCPU4_RAM4GIB
LIB_SANDBOX_VCPU=4
LIB_SANDBOX_GIB=4

# ===== Claude (Anthropic via Vertex AI) untuk tugas berat — cadangan Gemini 4 Argon =====
LIB_MODEL_CLAUDE=claude-opus-5-5
LIB_CLAUDE_REGION=global
