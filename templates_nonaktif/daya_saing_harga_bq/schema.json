{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Isi Laporan Daya Saing Harga (BigQuery)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "judul_utama",
    "cakupan",
    "periode",
    "ringkasan_eksekutif",
    "kpi_zona",
    "matriks",
    "grafik",
    "insight_strategis",
    "sumber_data"
  ],
  "properties": {
    "judul_utama": {
      "type": "string",
      "description": "Judul sampul, maks 14 kata. Contoh: 'Analisis daya saing harga retail & margin bengkel Q3 2026 vs Q2 2026'."
    },
    "cakupan": {
      "type": "string",
      "description": "Cakupan wilayah singkat, mis. 'Multizona', 'Nasional', 'Zona 1'."
    },
    "periode": {
      "type": "string",
      "description": "Periode data, mis. 'Q3 2026 vs Q2 2026' atau 'Mei 2026'."
    },
    "ringkasan_eksekutif": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "string"
      },
      "description": "Kesimpulan utama, 1-2 kalimat per poin, menyebut angka persis dari insight/data."
    },
    "kpi_zona": {
      "type": "array",
      "maxItems": 4,
      "description": "Kartu KPI per wilayah (mis. Nasional, Zona 1, Zona 2, Zona 3). Kosongkan [] jika data per wilayah tidak tersedia.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "judul",
          "metrik"
        ],
        "properties": {
          "judul": {
            "type": "string",
            "description": "Mis. 'Zona 1 (Region 3, 4, 5)'."
          },
          "subjudul": {
            "type": "string",
            "description": "Mis. 'Jawa-Nusra'."
          },
          "metrik": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "nilai",
                "arah"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "description": "Mis. 'Enduro Matic-S Gap HJ'."
                },
                "nilai": {
                  "type": "string",
                  "description": "Angka PERSIS dari data, format Indonesia, mis. '−9.390/L' atau 'Rp 10.596/L'."
                },
                "arah": {
                  "type": "string",
                  "enum": [
                    "baik",
                    "buruk",
                    "netral"
                  ],
                  "description": "Gap negatif (PTPL lebih murah) = baik; gap positif = buruk; margin lebih besar = baik."
                }
              }
            }
          },
          "catatan": {
            "type": "string",
            "description": "Satu kalimat kondisi wilayah."
          }
        }
      }
    },
    "matriks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kolom",
        "baris"
      ],
      "description": "Tabel gap per segmen/viskositas/SKU. Kolom terakhir boleh 'Status' berisi AMAN/WATCH/KRITIS. Kosongkan baris jika data tidak tersedia.",
      "properties": {
        "kolom": {
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "nama",
              "arah_baik"
            ],
            "properties": {
              "nama": {
                "type": "string",
                "description": "Mis. 'Gap HJ Nasional', 'Gap Margin Zona 1', 'Status'."
              },
              "arah_baik": {
                "type": "string",
                "enum": [
                  "negatif",
                  "positif",
                  "netral"
                ],
                "description": "Gap harga: negatif = baik. Gap margin: positif = baik. Status/teks: netral."
              }
            }
          }
        },
        "baris": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "jenis",
              "nilai"
            ],
            "properties": {
              "label": {
                "type": "string",
                "description": "Mis. 'MCO 10W-30 (Viscosity Avg)' atau '▸ ENDURO MATIC-S 0.8L (Hero)'."
              },
              "jenis": {
                "type": "string",
                "enum": [
                  "grup",
                  "hero",
                  "biasa"
                ],
                "description": "grup = baris judul segmen (nilai boleh kosong); hero = Product Hero."
              },
              "nilai": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Satu nilai per kolom, PERSIS dari data. 'NA' jika tidak ada."
              }
            }
          }
        },
        "catatan": {
          "type": "string",
          "description": "Definisi singkat, mis. 'Gap HJ = HJ PTPL − HJ Komp (negatif = PTPL lebih murah).'"
        }
      }
    },
    "grafik": {
      "type": "array",
      "maxItems": 4,
      "description": "Grafik dari TABEL DATA di insight. Setiap angka harus ada di data. Kosongkan [] jika tidak ada data yang cocok.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "judul",
          "jenis",
          "satuan",
          "kategori",
          "seri"
        ],
        "properties": {
          "judul": {
            "type": "string",
            "description": "Mis. 'Komparasi Gap HJ per Zona'."
          },
          "jenis": {
            "type": "string",
            "enum": [
              "bar",
              "line"
            ],
            "description": "bar untuk perbandingan, line untuk tren antar periode."
          },
          "satuan": {
            "type": "string",
            "description": "Mis. 'IDR/L'."
          },
          "kategori": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "string"
            },
            "description": "Label sumbu X, mis. produk atau periode."
          },
          "seri": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "nama",
                "nilai"
              ],
              "properties": {
                "nama": {
                  "type": "string",
                  "description": "Mis. 'Nasional', 'Zona 1'."
                },
                "nilai": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "description": "Satu angka per kategori, PERSIS dari data (dibulatkan boleh). null jika tidak ada."
                }
              }
            }
          },
          "catatan": {
            "type": "string"
          }
        }
      }
    },
    "insight_strategis": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kategori",
          "judul",
          "uraian",
          "tingkat"
        ],
        "properties": {
          "kategori": {
            "type": "string",
            "description": "Mis. 'I. CONSUMER VIEW · PROTEKSI HARGA ECERAN'."
          },
          "judul": {
            "type": "string"
          },
          "uraian": {
            "type": "string",
            "description": "2-3 kalimat, dengan angka persis dari data."
          },
          "tingkat": {
            "type": "string",
            "enum": [
              "positif",
              "perhatian",
              "kritis"
            ]
          }
        }
      }
    },
    "sumber_data": {
      "type": "string",
      "description": "Mis. 'Survey Response Report Retail · Q2 2026 vs Q3 2026 · Standardized per liter (IDR/L).' Jika ada dokumen, sebutkan juga."
    }
  }
}