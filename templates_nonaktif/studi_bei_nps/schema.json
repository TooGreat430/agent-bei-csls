{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Isi Laporan Studi BEI & NPS",
  "type": "object",
  "additionalProperties": false,
  "required": ["segmen", "periode", "judul_utama", "ringkasan_eksekutif", "latar_belakang", "tujuan",
               "temuan_utama", "rekomendasi", "keterbatasan", "daftar_sumber"],
  "properties": {
    "segmen": {"type": "string", "description": "Segmen studi, mis. 'Motor' atau 'Mobil'. Tulis 'Umum' jika tidak disebut di sumber."},
    "periode": {"type": "string", "description": "Periode studi, mis. 'Q1 2026'. Tulis 'Tidak disebutkan' jika tidak ada di sumber."},
    "judul_utama": {"type": "string", "description": "Judul sampul bergaya headline, maksimal 12 kata. Contoh: 'Monitoring performa dan potensi pasar melalui studi BEI dan NPS'."},
    "ringkasan_eksekutif": {
      "type": "array", "minItems": 3, "maxItems": 6, "items": {"type": "string"},
      "description": "Poin kesimpulan utama untuk pimpinan, masing-masing 1-2 kalimat, diakhiri label sitasi."
    },
    "latar_belakang": {"type": "string", "description": "Konteks studi, 1-2 paragraf dipisah baris kosong."},
    "tujuan": {
      "type": "array", "minItems": 1, "maxItems": 4,
      "items": {"type": "object", "additionalProperties": false, "required": ["judul", "uraian"],
                "properties": {"judul": {"type": "string", "description": "Judul tujuan, maksimal 8 kata."},
                               "uraian": {"type": "string", "description": "Penjelasan tujuan, maksimal 45 kata."}}}
    },
    "temuan_utama": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["judul", "pesan_utama", "poin", "sitasi"],
        "properties": {
          "judul": {"type": "string", "description": "Judul topik temuan, singkat. Contoh: 'Brand Equity Index', 'Net Promoter Score by Brand'."},
          "pesan_utama": {"type": "string", "description": "Satu kalimat kesimpulan (headline) dari temuan ini."},
          "poin": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "string"},
                   "description": "Poin pendukung, masing-masing 1-2 kalimat."},
          "tabel": {
            "type": "object", "additionalProperties": false, "required": ["kolom", "baris"],
            "description": "OPSIONAL. Isi hanya jika angka tersedia di insight/kutipan. Semua sel berupa teks. Jangan mengarang angka.",
            "properties": {
              "kolom": {"type": "array", "maxItems": 6, "items": {"type": "string"}},
              "baris": {"type": "array", "maxItems": 12, "items": {"type": "array", "items": {"type": "string"}}}
            }
          },
          "sitasi": {"type": "array", "minItems": 1, "items": {"type": "string"},
                     "description": "Label sitasi persis dari sumber, mis. '[Studi BEI Motor Q1 2026, v1, hal. 31]'."}
        }
      }
    },
    "rekomendasi": {
      "type": "array", "minItems": 1, "maxItems": 6,
      "items": {"type": "object", "additionalProperties": false, "required": ["area", "tindakan", "prioritas", "alasan"],
                "properties": {"area": {"type": "string", "description": "Area perbaikan, mis. 'Distribusi', 'Promosi'."},
                               "tindakan": {"type": "string"},
                               "prioritas": {"type": "string", "enum": ["Tinggi", "Sedang", "Rendah"]},
                               "alasan": {"type": "string", "description": "Kaitkan dengan temuan."}}}
    },
    "keterbatasan": {"type": "string", "description": "Keterbatasan data atau cakupan sumber yang dipakai."},
    "daftar_sumber": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["judul_dokumen", "versi"],
                "properties": {"judul_dokumen": {"type": "string"}, "versi": {"type": "string"}}}
    }
  }
}
